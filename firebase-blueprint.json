{
  "entities": {
    "SiteSetting": {
      "title": "SiteSetting",
      "description": "Global website settings, contact info, SEO, and footer content",
      "type": "object",
      "properties": {
        "siteTitle": { "type": "string" },
        "brandName": { "type": "string" },
        "brandRole": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "availabilityText": { "type": "string" },
        "footerText": { "type": "string" },
        "footerSubtitle": { "type": "string" },
        "resumeUrl": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["siteTitle", "brandName", "email"]
    },
    "Page": {
      "title": "Page",
      "description": "Page hero copy, section headlines, and lead content",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "heroKicker": { "type": "string" },
        "heroTitle": { "type": "string" },
        "heroCopy": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title"]
    },
    "Project": {
      "title": "Project",
      "description": "Portfolio case studies, selected work, and dynamic case study sections",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "category": { "type": "string" },
        "categoryLabel": { "type": "string" },
        "year": { "type": "string" },
        "summary": { "type": "string" },
        "shortSummary": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "introduction": { "type": "string" },
        "role": { "type": "string" },
        "duration": { "type": "string" },
        "deliverables": { "type": "array" },
        "figmaUrl": { "type": "string" },
        "figmaButtonText": { "type": "string" },
        "externalProjectUrl": { "type": "string" },
        "coverImage": { "type": "string" },
        "status": { "type": "string" },
        "featured": { "type": "boolean" },
        "order": { "type": "number" },
        "displayOrder": { "type": "number" },
        "sections": { "type": "array" },
        "seo": { "type": "object" },
        "updatedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "slug", "category", "status", "order"]
    },
    "Experience": {
      "title": "Experience",
      "description": "Career timeline and experience entries",
      "type": "object",
      "properties": {
        "role": { "type": "string" },
        "company": { "type": "string" },
        "location": { "type": "string" },
        "dates": { "type": "string" },
        "duration": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "number" },
        "current": { "type": "boolean" },
        "visible": { "type": "boolean" }
      },
      "required": ["role", "company", "dates"]
    },
    "Education": {
      "title": "Education",
      "description": "Education, degree, and language credentials",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "institution": { "type": "string" },
        "dates": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "number" },
        "visible": { "type": "boolean" }
      },
      "required": ["title", "institution"]
    },
    "Skill": {
      "title": "Skill",
      "description": "Technical and design skill tags or categories",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "order": { "type": "number" },
        "visible": { "type": "boolean" }
      },
      "required": ["name"]
    },
    "NavigationItem": {
      "title": "NavigationItem",
      "description": "Header navigation links and action items",
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "route": { "type": "string" },
        "order": { "type": "number" },
        "visible": { "type": "boolean" },
        "external": { "type": "boolean" }
      },
      "required": ["label", "route"]
    },
    "SocialLink": {
      "title": "SocialLink",
      "description": "Footer and contact links",
      "type": "object",
      "properties": {
        "platform": { "type": "string" },
        "label": { "type": "string" },
        "url": { "type": "string" },
        "order": { "type": "number" },
        "visible": { "type": "boolean" }
      },
      "required": ["label", "url"]
    },
    "MediaItem": {
      "title": "MediaItem",
      "description": "Media library assets metadata",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "storagePath": { "type": "string" },
        "mimeType": { "type": "string" },
        "size": { "type": "number" },
        "alt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "url", "mimeType"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Secure CMS administrator credentials",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "passwordHash": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["username", "passwordHash", "role"]
    }
  },
  "firestore": {
    "/site_settings/{settingId}": {
      "schema": "SiteSetting",
      "description": "Global website configuration, metadata, and footer settings"
    },
    "/pages/{pageId}": {
      "schema": "Page",
      "description": "Page level content definitions"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Selected work and case studies"
    },
    "/experience/{experienceId}": {
      "schema": "Experience",
      "description": "Professional experience timeline entries"
    },
    "/education/{educationId}": {
      "schema": "Education",
      "description": "Education and language qualifications"
    },
    "/skills/{skillId}": {
      "schema": "Skill",
      "description": "Design and development skill tags"
    },
    "/navigation/{navId}": {
      "schema": "NavigationItem",
      "description": "Site navigation links"
    },
    "/social_links/{linkId}": {
      "schema": "SocialLink",
      "description": "Footer and social media links"
    },
    "/media/{mediaId}": {
      "schema": "MediaItem",
      "description": "Uploaded media library files and metadata"
    },
    "/admin_users/{userId}": {
      "schema": "AdminUser",
      "description": "CMS administrator accounts"
    }
  }
}
